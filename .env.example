# TerraSense (PS-010) Environment Configuration
# Copy this file to .env and replace all placeholder values before running.

# Runtime environment: development | demo | testing | production
ENVIRONMENT=development

# Application Metadata
PROJECT_NAME="PS-010: Digital Sand Quality Management & Rejection Analytics"
VERSION=1.0.0

# Database Configuration
# Local SQLite (development/testing only):
DATABASE_URL=sqlite:///./foundry_quality.db
# Production PostgreSQL (required when ENVIRONMENT=production):
# DATABASE_URL=postgresql://terrasense_app:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/foundry_quality

# PostgreSQL Container Credentials (used by docker-compose.yml)
POSTGRES_DB=foundry_quality
POSTGRES_USER=terrasense_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Authentication & Security
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated, no wildcard when credentials enabled)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Mode & Sample Data Seeding
# MUST be false in production. Startup will refuse DEMO_MODE=true in production.
DEMO_MODE=false
